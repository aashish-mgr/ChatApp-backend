# Port the Socket.IO server listens on.
PORT=3000

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/chatapp

# Secret used to sign access tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime (jsonwebtoken syntax), e.g. 1h, 12h, 7d.
ACCESS_TOKEN_EXPIRE=1h

# Frontend origin allowed by CORS (the Next.js dev server).
CLIENT_URL=http://localhost:3001
