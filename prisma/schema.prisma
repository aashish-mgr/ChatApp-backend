// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  password     String       @db.VarChar(255)
  createdAt    DateTime     @default(now())
  messages     Message[]
  rooms        RoomMember[]
  createdRooms Room[]       @relation("RoomCreator")
  attachments  Attachment[]
}

model Room {
  id          String       @id @default(uuid())
  name        String
  isGroup     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  createdBy   User?        @relation("RoomCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  messages    Message[]
  members     RoomMember[]
  attachments Attachment[]

  @@index([createdById])
}

model Message {
  id           String      @id @default(uuid())
  content      String
  createdAt    DateTime    @default(now())
  /// Set the first time the sender edits the message; null when never edited.
  editedAt     DateTime?
  sender       User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId     String
  room         Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId       String
  /// Optional file attached to the message. Unique: one attachment belongs to
  /// at most one message. The attachment row is created by the upload before
  /// the message exists, so it starts out unlinked.
  attachmentId String?     @unique
  attachment   Attachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@index([senderId])
}

/// A file uploaded to a room. Created by `POST /api/attachments` and linked to
/// a message when that message is sent.
model Attachment {
  id         String   @id @default(uuid())
  /// Name of the file as the uploader sent it (sanitized, never used as a path).
  filename   String
  /// Opaque name the file is stored under. Unique, so it is safe to serve.
  storedName String   @unique
  mimeType   String
  /// Size in bytes.
  size       Int
  createdAt  DateTime @default(now())
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId     String
  /// The message this attachment belongs to, once it has been sent.
  message    Message?

  @@index([roomId])
  @@index([uploaderId])
  /// Supports the sweep that removes uploads which were never sent.
  @@index([createdAt])
}

model RoomMember {
  userId     String
  roomId     String
  joinedAt   DateTime  @default(now())
  /// Last time this member read the room. Unread messages are the ones sent
  /// by someone else after this instant (falling back to `joinedAt`).
  lastReadAt DateTime?
  /// Role of the member in a group chat (e.g. admin). Defaults to member.
  role       String    @default("member")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@index([roomId])
}
